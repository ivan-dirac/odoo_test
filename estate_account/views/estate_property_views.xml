<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form.inherit.estate_account</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="real_state.estate_property_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" string="Ver factura" invisible="account_move_id==False"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>